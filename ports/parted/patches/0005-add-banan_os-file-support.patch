+#include <config.h>
+
+#include <parted/parted.h>
+#include <parted/debug.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#if ENABLE_NLS
+#  include <libintl.h>
+#  define _(String) dgettext (PACKAGE, String)
+#else
+#  define _(String) (String)
+#endif /* ENABLE_NLS */
+
+#include "../architecture.h"
+
+#define BANANOS_SPECIFIC(dev)	((bananos_specific*) (dev)->arch_specific)
+
+typedef	struct bananos_specific	bananos_specific;
+
+struct bananos_specific {
+	int fd;
+};
+
+static int
+_device_fsync (PedDevice* dev)
+{
+	struct bananos_specific* arch_specific = BANANOS_SPECIFIC (dev);
+	PedExceptionOption ex_status;
+	int status;
+
+	while (1) {
+		status = fsync (arch_specific->fd);
+		if (status >= 0)
+			break;
+
+		ex_status = ped_exception_throw (
+			PED_EXCEPTION_ERROR,
+			PED_EXCEPTION_RETRY_IGNORE_CANCEL,
+			_("%s during sync on %s"), strerror (errno), dev->path);
+
+		switch (ex_status) {
+			case PED_EXCEPTION_IGNORE:
+				return 1;
+			case PED_EXCEPTION_RETRY:
+				break;
+			case PED_EXCEPTION_UNHANDLED:
+				ped_exception_catch ();
+				/* FALLTHROUGH */
+			case PED_EXCEPTION_CANCEL:
+				return 0;
+			default:
+				PED_ASSERT (0);
+		}
+	}
+
+	return 1;
+}
+
+static void
+bananos_destroy (PedDevice* dev)
+{
+	free (dev->arch_specific);
+	free (dev->model);
+	free (dev->path);
+	free (dev);
+}
+
+static PedDeviceType
+_device_init_file (PedDevice* dev, struct stat* st)
+{
+	dev->sector_size = PED_SECTOR_SIZE_DEFAULT;
+	dev->phys_sector_size = PED_SECTOR_SIZE_DEFAULT;
+
+	dev->length = st->st_size / dev->sector_size;
+
+	dev->hw_geom.heads = 4;
+	dev->hw_geom.sectors = 32;
+	dev->hw_geom.cylinders = dev->length / (dev->hw_geom.heads * dev->hw_geom.sectors);
+	dev->bios_geom = dev->hw_geom;
+
+	dev->model = strdup (_("Disk Image"));
+	if (!dev->model)
+		return PED_DEVICE_UNKNOWN;
+
+	return PED_DEVICE_FILE;
+}
+
+static PedDeviceType
+_device_init (PedDevice* dev)
+{
+	struct stat st;
+	PedDeviceType type = PED_DEVICE_UNKNOWN;
+
+	if (stat (dev->path, &st) < 0)
+		goto done;
+
+	if (S_ISREG (st.st_mode))
+		type = _device_init_file (dev, &st);
+
+done:
+	return type;
+}
+
+static PedDevice*
+bananos_new (const char* path)
+{
+	PedDevice* dev;
+
+	dev = (PedDevice*) ped_malloc (sizeof (PedDevice));
+	if (!dev)
+		goto error;
+
+	dev->path = strdup (path);
+	if (!dev->path)
+		goto error_free_dev;
+
+	dev->arch_specific = (struct bananos_specific*) ped_malloc (sizeof (bananos_specific));
+	if (!dev->arch_specific)
+		goto error_free_path;
+
+	dev->open_count = 0;
+	dev->read_only = 0;
+	dev->external_mode = 0;
+	dev->dirty = 0;
+	dev->boot_dirty = 0;
+
+	if ((dev->type = _device_init (dev)) <= 0)
+		goto error_free_arch_specific;
+
+	return dev;
+
+error_free_arch_specific:
+	free (dev->arch_specific);
+
+error_free_path:
+	free (dev->path);
+
+error_free_dev:
+	free (dev);
+
+error:
+	return NULL;
+}
+
+static int
+bananos_is_busy (PedDevice* dev)
+{
+	return 0;
+}
+
+static int
+bananos_open (PedDevice* dev)
+{
+	struct bananos_specific* arch_specific = BANANOS_SPECIFIC (dev);
+
+retry:
+	arch_specific->fd = open (dev->path, O_RDWR);
+	if (arch_specific->fd < 0) {
+		int rw_errno = errno;
+
+		arch_specific->fd = open (dev->path, O_RDONLY);
+		if (arch_specific->fd < 0) {
+			if (ped_exception_throw (
+				PED_EXCEPTION_ERROR,
+				PED_EXCEPTION_RETRY_CANCEL,
+				_("Error opening %s: %s"), dev->path, strerror (errno)
+			) != PED_EXCEPTION_RETRY) {
+				return 0;
+			} else {
+				goto retry;
+			}
+		} else {
+			ped_exception_throw (
+				PED_EXCEPTION_WARNING,
+				PED_EXCEPTION_OK,
+				_("Unable to open %s read-write (%s).  %s has been opened read-only."),
+				dev->path, strerror (rw_errno), dev->path);
+			dev->read_only = 1;
+		}
+	} else {
+		dev->read_only = 0;
+	}
+
+	_device_fsync (dev);
+
+	return 1;
+}
+
+static int
+bananos_refresh_open (PedDevice* dev)
+{
+	return 1;
+}
+
+static int
+bananos_close (PedDevice* dev)
+{
+	struct bananos_specific* arch_specific = BANANOS_SPECIFIC (dev);
+
+	if (dev->dirty)
+		_device_fsync (dev);
+
+	close (arch_specific->fd);
+
+	return 1;
+}
+
+static int
+bananos_refresh_close (PedDevice* dev)
+{
+	if (dev->dirty)
+		_device_fsync (dev);
+
+	return 1;
+}
+
+static int
+bananos_read (const PedDevice* dev, void* buffer, PedSector start, PedSector count)
+{
+	struct bananos_specific* arch_specific = BANANOS_SPECIFIC (dev);
+	off_t offset = start * dev->sector_size;
+	size_t length = count * dev->sector_size;
+	PedExceptionOption ex_status;
+	int status;
+
+	while (length > 0) {
+		status = pread (arch_specific->fd, buffer, length, offset);
+
+		if (status > 0) {
+			length -= status;
+			offset += status;
+			buffer += status;
+			continue;
+		}
+
+		ex_status = ped_exception_throw (
+			PED_EXCEPTION_ERROR,
+			PED_EXCEPTION_RETRY_IGNORE_CANCEL,
+			_("%s during read on %s"), strerror (errno), dev->path);
+		
+		switch (ex_status) {
+			case PED_EXCEPTION_IGNORE:
+				return 1;
+			case PED_EXCEPTION_RETRY:
+				break;
+			case PED_EXCEPTION_UNHANDLED:
+				ped_exception_catch ();
+				/* FALLTHROUGH */
+			case PED_EXCEPTION_CANCEL:
+				return 0;
+			default:
+				PED_ASSERT (0);
+				break;
+		}
+	}
+
+	return 1;
+}
+
+static int
+bananos_write (PedDevice* dev, const void* buffer, PedSector start, PedSector count)
+{
+	struct bananos_specific* arch_specific = BANANOS_SPECIFIC (dev);
+	off_t offset = start * dev->sector_size;
+	size_t length = count * dev->sector_size;
+	PedExceptionOption ex_status;
+	int status;
+
+	if (dev->read_only) {
+		ex_status = ped_exception_throw (
+			PED_EXCEPTION_ERROR,
+			PED_EXCEPTION_IGNORE_CANCEL,
+			_("Can't write to %s, because it is opened read-only."), dev->path);
+		if (ex_status == PED_EXCEPTION_IGNORE) {
+			return 0;
+		} else {
+			return 1;
+		}
+	}
+
+#ifdef READ_ONLY
+	printf ("ped_device_write (\"%s\", %p, %d, %d)\n",
+		dev->path, buffer, (int) start, (int) count);
+#else
+	dev->dirty = 1;
+	while (length > 0) {
+		status = pwrite (arch_specific->fd, buffer, length, offset);
+
+		if (status > 0) {
+			length -= status;
+			offset += status;
+			buffer += status;
+			continue;
+		}
+
+		ex_status = ped_exception_throw (
+			PED_EXCEPTION_ERROR,
+			PED_EXCEPTION_RETRY_IGNORE_CANCEL,
+			_("%s during write on %s"), strerror (errno), dev->path);
+		
+		switch (ex_status) {
+			case PED_EXCEPTION_IGNORE:
+				return 1;
+			case PED_EXCEPTION_RETRY:
+				break;
+			case PED_EXCEPTION_UNHANDLED:
+				ped_exception_catch ();
+				/* FALLTHROUGH */
+			case PED_EXCEPTION_CANCEL:
+				return 0;
+			default:
+				PED_ASSERT (0);
+				break;
+		}
+	}
+#endif /* !READ_ONLY */
+
+	return 1;
+}
+
+static PedSector
+bananos_check (PedDevice* dev, void* buffer, PedSector start, PedSector count)
+{
+	return count;
+}
+
+static int
+bananos_sync (PedDevice* dev)
+{
+	if (dev->read_only || !dev->dirty)
+		return 1;
+
+	if (!_device_fsync (dev))
+		return 0;
+
+	return 1;
+}
+
+static void
+bananos_probe_all ()
+{
+}
+
+static char*
+bananos_partition_get_path (const PedPartition* part)
+{
+	return NULL;
+}
+
+static int
+bananos_partition_is_busy (const PedPartition* part)
+{
+	return 0;
+}
+
+static int
+bananos_disk_commit (PedDisk* disk)
+{
+	return 1;
+}
+
+static PedDeviceArchOps bananos_dev_ops = {
+	_new:			bananos_new,
+	destroy:		bananos_destroy,
+	is_busy:		bananos_is_busy,
+	open:			bananos_open,
+	refresh_open:	bananos_refresh_open,
+	close:			bananos_close,
+	refresh_close:	bananos_refresh_close,
+	read:			bananos_read,
+	write:			bananos_write,
+	check:			bananos_check,
+	sync:			bananos_sync,
+	sync_fast:		bananos_sync,
+	probe_all:		bananos_probe_all
+};
+
+static PedDiskArchOps bananos_disk_ops = {
+	partition_get_path:	bananos_partition_get_path,
+	partition_is_busy:	bananos_partition_is_busy,
+	disk_commit:		bananos_disk_commit
+};
+
+PedArchitecture ped_bananos_arch = {
+	dev_ops:	&bananos_dev_ops,
+	disk_ops:	&bananos_disk_ops
+};
