diff -ruN libgcrypt-1.12.2/configure libgcrypt-1.12.2-banan_os/configure
--- libgcrypt-1.12.2/configure	2026-04-15 12:12:28.000000000 +0300
+++ libgcrypt-1.12.2-banan_os/configure	2026-05-22 19:14:58.019421875 +0300
@@ -8041,6 +8041,10 @@
   lt_cv_deplibs_check_method=pass_all
   ;;
 
+banan_os*)
+  lt_cv_deplibs_check_method=pass_all
+  ;;
+
 beos*)
   lt_cv_deplibs_check_method=pass_all
   ;;
@@ -13705,6 +13709,16 @@
   esac
   ;;
 
+banan_os*)
+  version_type=linux # correct to gnu/linux during the next big refactor
+  need_lib_prefix=no
+  need_version=no
+  library_names_spec='$libname$release$shared_ext$versuffix $libname$release$shared_ext$major $libname$shared_ext'
